# Zrzur main-server edge. The files in /etc/caddy/zrzur are generated by prepare-config.py
# from Cloudflare's published ranges: trusted-proxies.caddy (trusted_proxies directive) and
# cloudflare-only.caddy (403 for any client that is not a Cloudflare edge).
{
	admin off
	servers {
		protocols h1 h2
		import /etc/caddy/zrzur/trusted-proxies.caddy
		trusted_proxies_strict
	}
}

app.zrzur.com {
	import /etc/caddy/zrzur/cloudflare-only.caddy
	reverse_proxy web:5000
}

# Zrzur Beta: the beta web app, on the same backend as app.zrzur.com
beta.zrzur.com {
	import /etc/caddy/zrzur/cloudflare-only.caddy
	reverse_proxy web-beta:5000
}

# The public Discover and Designs sites: no account needed to browse. The
# pages set frame-ancestors themselves; the rest is here.
(public-site) {
	import /etc/caddy/zrzur/cloudflare-only.caddy
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "geolocation=(), payment=(), interest-cohort=()"
		-Server
	}
	encode zstd gzip
}

discover.zrzur.com {
	import public-site
	reverse_proxy discover:5000
}

designs.zrzur.com {
	import public-site
	reverse_proxy designs:5000
}

# The team's admin console: static files with strict headers (a <meta> CSP
# cannot set frame-ancestors). It talks to api.zrzur.com/staff only.
# To limit it to the team's addresses, add a file
# /etc/caddy/zrzur/admin-allow.caddy with
#   @outside not remote_ip <addresses>
#   respond @outside 403
# and import it here.
# Reached only through an SSH tunnel: the port is published on 127.0.0.1.
http://:8090 {
	header {
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src https://api.zrzur.com; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		X-Frame-Options DENY
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Cache-Control no-store
		-Server
	}
	root * /srv/admin
	try_files {path} /index.html
	file_server
}

api.zrzur.com {
	import /etc/caddy/zrzur/cloudflare-only.caddy
	# internal numbers stay inside; the console reads /staff/operations/metrics.
	# In a handle block: Caddy runs handle before a bare respond.
	@internal path /metrics /metrics/*
	handle @internal {
		respond 404
	}
	handle_path /january/* {
		reverse_proxy january:14705
	}
	handle_path /gifbox/* {
		reverse_proxy gifbox:14706
	}
	handle_path /ingress/* {
		reverse_proxy voice-ingress:8500
	}
	handle {
		reverse_proxy api:14702
	}
}

events.zrzur.com {
	import /etc/caddy/zrzur/cloudflare-only.caddy
	reverse_proxy events:14703
}

cdn.zrzur.com {
	import /etc/caddy/zrzur/cloudflare-only.caddy
	reverse_proxy autumn:14704
}

# The website: the built site from zrzur/website (its dist folder)
zrzur.com {
	import /etc/caddy/zrzur/cloudflare-only.caddy
	@source path /source /source/*
	redir @source https://github.com/zrzur 302
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		-Server
	}
	# Files Vite emitted carry a hash in their name: kept for a year. Files with
	# stable names (product pictures, brand) may be replaced: an hour. Pages are
	# always checked, so a new release reaches every visitor on the next visit.
	@hashed path_regexp ^/assets/[^/]+-[A-Za-z0-9_-]{8}\.[a-z0-9]+$
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@stable {
		path /assets/* /brand/*
		not path_regexp ^/assets/[^/]+-[A-Za-z0-9_-]{8}\.[a-z0-9]+$
	}
	header @stable Cache-Control "public, max-age=3600"
	@pages not path /assets/* /brand/*
	header @pages Cache-Control "no-cache"
	root * /srv/website
	try_files {path} {path}.html {path}/index.html /index.html
	file_server
}

www.zrzur.com {
	import /etc/caddy/zrzur/cloudflare-only.caddy
	redir https://zrzur.com{uri} 308
}

status.zrzur.com {
	import /etc/caddy/zrzur/cloudflare-only.caddy
	header Cache-Control "no-store"
	respond "Zrzur release acceptance is incomplete." 503
}

# Short invite/share domain — resolve codes only; do not set auth cookies here.
# Path /{code} → app invite preview; custom server links (zrzur.cc/arab-gamers)
# join words with single hyphens. Path /p/{id} reserved for future content shares.
zrzur.cc {
	import /etc/caddy/zrzur/cloudflare-only.caddy
	@invite path_regexp invite ^/([A-Za-z0-9]+(?:-[A-Za-z0-9]+)*)$
	redir @invite https://app.zrzur.com/invite/{re.invite.1} 302
	@share path_regexp share ^/p/([A-Za-z0-9_-]+)$
	redir @share https://app.zrzur.com/discover/{re.share.1} 302
	respond "Zrzur invite links use https://zrzur.cc/{code}" 404
}
