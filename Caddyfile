{
	servers {
		# Set by generate_config.sh behind another reverse proxy; without it
		# nobody is trusted and a client cannot choose its own address.
		trusted_proxies static {$TRUSTED_PROXIES:127.0.0.1/32}
		trusted_proxies_strict
	}
}

{$HOSTNAME} {
	# internal numbers stay inside. In a handle block: Caddy runs route and
	# handle before a bare respond, so that would never be reached.
	@metrics path /api/metrics /api/metrics/*
	handle @metrics {
		respond 404
	}

	route /.well-known/stoat {
		uri strip_prefix /.well-known/stoat
		header {
			Access-Control-Allow-Origin *
		}
		file_server {
			root /stoat.json
		}
	}

	route /api* {
		uri strip_prefix /api
		reverse_proxy http://api:14702 {
			# one address, the real client: the API reads a single value
			header_up X-Forwarded-For {client_ip}
			header_down Location "^/" "/api/"
		}
	}

	route /ws {
		uri strip_prefix /ws
		reverse_proxy http://events:14703 {
			# one address, the real client: the API reads a single value
			header_up X-Forwarded-For {client_ip}
			header_down Location "^/" "/ws/"
		}
	}

	route /autumn* {
		uri strip_prefix /autumn
		reverse_proxy http://autumn:14704 {
			# one address, the real client: the API reads a single value
			header_up X-Forwarded-For {client_ip}
			header_down Location "^/" "/autumn/"
		}
	}

	route /january* {
		uri strip_prefix /january
		reverse_proxy http://january:14705 {
			# one address, the real client: the API reads a single value
			header_up X-Forwarded-For {client_ip}
			header_down Location "^/" "/january/"
		}
	}

	route /gifbox* {
		uri strip_prefix /gifbox
		reverse_proxy http://gifbox:14706 {
			# one address, the real client: the API reads a single value
			header_up X-Forwarded-For {client_ip}
			header_down Location "^/" "/gifbox/"
		}
	}

	route /livekit* {
		uri strip_prefix /livekit
		reverse_proxy http://livekit:7880 {
			header_down Location "^/" "/livekit/"
		}
	}

	route /ingress* {
		uri strip_prefix /ingress
		reverse_proxy http://voice-ingress:8500 {
			header_down Location "^/" "/ingress/"
		}
	}

	reverse_proxy http://web:5000
}
